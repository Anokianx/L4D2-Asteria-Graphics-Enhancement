#version 450
layout(local_size_x=8, local_size_y=8) in;
layout(binding=0) uniform sampler2D currentColor;
layout(binding=1) uniform sampler2D previousColor;
layout(binding=2) uniform sampler2D currentDepth;
layout(binding=3) uniform sampler2D previousDepth;
layout(binding=4) uniform isampler2D currentToPrevious;
layout(binding=5) uniform isampler2D previousToCurrent;
layout(binding=6) uniform sampler2D currentHudMask;
layout(binding=7) uniform sampler2D previousHudMask;
layout(binding=8) uniform usampler2D sceneChange;
layout(binding=9) uniform usampler2D reverseSceneChange;
layout(binding=10, rg16f) writeonly uniform image2D motionOutput;
layout(binding=11, r32f) writeonly uniform image2D confidenceOutput;
layout(push_constant) uniform Parameters
{
    uvec2 size;
    uint blockSize;
    uint historyValid;
    float forwardBackwardLimit;
    float photometricLimit;
    float depthLimit;
    float minimumTexture;
    float minimumConfidence;
    uint reversedDepth;
    uint forwardHistoryFrames;
    uint reverseHistoryFrames;
} parameters;

bool finite1(float x) { return !isnan(x) && !isinf(x); }
bool inside(vec2 p) { return all(greaterThanEqual(p, vec2(1.5))) && all(lessThan(p, vec2(parameters.size)-vec2(1.5))); }
float photoError(vec2 p, vec2 q)
{
    float error=0.0;
    for(int y=-1;y<=1;++y)
        for(int x=-1;x<=1;++x)
        {
            vec2 offset=vec2(x,y);
            vec3 a=textureLod(currentColor,(p+offset)/vec2(parameters.size),0).rgb;
            vec3 b=textureLod(previousColor,(q+offset)/vec2(parameters.size),0).rgb;
            error+=dot(abs(a-b),vec3(0.3333333333));
        }
    return error/9.0;
}

void main()
{
    ivec2 pixel=ivec2(gl_GlobalInvocationID.xy);
    if(any(greaterThanEqual(uvec2(pixel),parameters.size))) return;
    bool motionInside=all(lessThan(pixel,imageSize(motionOutput)));
    bool confidenceInside=all(lessThan(pixel,imageSize(confidenceOutput)));
    if(motionInside) imageStore(motionOutput,pixel,vec4(0.0));
    if(confidenceInside) imageStore(confidenceOutput,pixel,vec4(0.0));
    if(!motionInside || !confidenceInside) return;
    ivec2 expected=ivec2(parameters.size);
    ivec2 expectedFlow=ivec2((parameters.size+uvec2(7))/8u);
    if(imageSize(motionOutput)!=expected || imageSize(confidenceOutput)!=expected ||
       textureSize(currentColor,0)!=expected || textureSize(previousColor,0)!=expected ||
       textureSize(currentDepth,0)!=expected || textureSize(previousDepth,0)!=expected ||
       textureSize(currentHudMask,0)!=expected || textureSize(previousHudMask,0)!=expected ||
       textureSize(currentToPrevious,0)!=expectedFlow || textureSize(previousToCurrent,0)!=expectedFlow ||
       textureSize(sceneChange,0).x<2 || textureSize(sceneChange,0).y<1 ||
       textureSize(reverseSceneChange,0).x<2 || textureSize(reverseSceneChange,0).y<1) return;
    if(parameters.historyValid==0 || parameters.forwardHistoryFrames<=5 || parameters.reverseHistoryFrames<=5 ||
       ((texelFetch(sceneChange,ivec2(1,0),0).r | texelFetch(reverseSceneChange,ivec2(1,0),0).r) & 15u)!=0u) return;
    vec2 p=vec2(pixel)+vec2(0.5);
    float depth=texelFetch(currentDepth,pixel,0).r;
    float currentMask=texelFetch(currentHudMask,pixel,0).r;
    if(!inside(p) || !finite1(depth) || depth<=0.0 || depth>=1.0 || !finite1(currentMask) || currentMask!=0.0) return;
    vec3 center=texelFetch(currentColor,pixel,0).rgb;
    float textureStrength=length(center-texelFetch(currentColor,pixel+ivec2(1,0),0).rgb)
                         +length(center-texelFetch(currentColor,pixel+ivec2(0,1),0).rgb);
    if(!finite1(textureStrength) || textureStrength<parameters.minimumTexture) return;
    ivec2 block=pixel/int(parameters.blockSize);
    ivec2 flowSize=textureSize(currentToPrevious,0);
    vec2 best=vec2(0.0);
    float bestScore=1e30;
    float confidence=0.0;
    for(int y=-1;y<=1;++y)
        for(int x=-1;x<=1;++x)
        {
            ivec2 cell=clamp(block+ivec2(x,y),ivec2(0),flowSize-1);
            vec2 flow=vec2(texelFetch(currentToPrevious,cell,0).rg);
            vec2 q=p+flow;
            if(!inside(q)) continue;
            vec2 uv=q/vec2(parameters.size);
            float oldMask=textureLod(previousHudMask,uv,0).r;
            if(!finite1(oldMask) || oldMask!=0.0) continue;
            float oldDepth=textureLod(previousDepth,uv,0).r;
            if(!finite1(oldDepth) || oldDepth<=0.0 || oldDepth>=1.0 || abs(oldDepth-depth)>parameters.depthLimit) continue;
            ivec2 reverseCell=clamp(ivec2(q)/int(parameters.blockSize),ivec2(0),textureSize(previousToCurrent,0)-1);
            vec2 reverseFlow=vec2(texelFetch(previousToCurrent,reverseCell,0).rg);
            float consistency=length(flow+reverseFlow);
            if(consistency>parameters.forwardBackwardLimit) continue;
            float error=photoError(p,q);
            if(!finite1(error) || error>parameters.photometricLimit) continue;
            float score=error+0.02*consistency+0.00001*float(x*x+y*y);
            if(score<bestScore)
            {
                bestScore=score;
                best=flow/vec2(parameters.size);
                confidence=clamp(1.0-error/parameters.photometricLimit,0.0,1.0)
                          *clamp(1.0-consistency/parameters.forwardBackwardLimit,0.0,1.0);
            }
        }
    if(confidence>=parameters.minimumConfidence)
    {
        imageStore(motionOutput,pixel,vec4(best,0.0,0.0));
        imageStore(confidenceOutput,pixel,vec4(confidence,0.0,0.0,0.0));
    }
}
